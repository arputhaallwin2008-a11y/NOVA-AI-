{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "systemPrompt": { "type": "string", "maxLength": 2000 },
        "modelName": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 50000 },
        "createdAt": { "type": "string" },
        "modelName": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["streaming", "completed", "error"] }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "createdAt"]
    },
    "StarredItem": {
      "title": "StarredItem",
      "description": "Bookmarked response",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "messageId": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "messageId", "conversationId", "createdAt"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "Image generated by AI studio",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "prompt": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "aspectRatio": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "prompt", "imageUrl", "createdAt"]
    },
    "UserMemory": {
      "title": "UserMemory",
      "description": "Personal AI memory preference",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "memoryContent": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "memoryContent", "createdAt", "updatedAt"]
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "User preferences and system prompt settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "preferredLanguage": { "type": "string", "maxLength": 32 },
        "voiceEnabled": { "type": "boolean" },
        "voiceName": { "type": "string", "maxLength": 32 },
        "systemPrompt": { "type": "string", "maxLength": 4000 },
        "webSearchEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "theme", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/preferences/settings": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "User preferences"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversations collection owned by user"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside user conversation"
    },
    "/users/{userId}/starred/{starredId}": {
      "schema": { "$ref": "#/entities/StarredItem" },
      "description": "Starred messages for user"
    },
    "/users/{userId}/images/{imageId}": {
      "schema": { "$ref": "#/entities/GeneratedImage" },
      "description": "Generated images for user"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/UserMemory" },
      "description": "Personal memories for user"
    }
  }
}
